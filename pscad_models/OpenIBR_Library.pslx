      <script>
        <segment classid="CoreSegment" id="1060352399" name="Dsdyn"><![CDATA[! Base Inverter Parameters
$Out(1) = $MVA_Base
$Out(2) = $inv_kV
$Out(3) = $freq
$Out(4) = $Plim
$Out(5) = $Qlim
