$Out(8) = 0
$Out(9) = 0
$Out(10)= 0

$Out(11)= $invType

! Project Parameters
$Out(21) = $Inv_Num

! VSM Parameters
$Out(40) = 0
$Out(41) = $VSM_Kdroop
$Out(42) = $VSM_H
$Out(43) = $VSM_Kdamp
$Out(44) = $VSM_R
$Out(45) = $VSM_L
$Out(46) = $VSM_Scale ! Machine % size for PV
$Out(47) = $tau_d   ! Washout time const
$Out(48) = $VSM_QV_droop
$Out(49) = 0
$Out(50) = $VSM_Enable_Delay

! Undervoltage Protection 
$Out(61) = $UV_1
$Out(62) = $UV_2
$Out(63) = $UV_3
$Out(64) = $UV_t1
$Out(65) = $UV_t2
$Out(66) = $UV_t3
! Overvoltage Protection 
$Out(67) = $OV_1
$Out(68) = $OV_2
$Out(69) = $OV_3
$Out(70) = $OV_t1
$Out(71) = $OV_t2
$Out(72) = $OV_t3
! Underfrequency Protection 
$Out(73) = $UF_1
$Out(74) = $UF_2
$Out(75) = $UF_3
$Out(76) = $UF_t1
$Out(77) = $UF_t2
$Out(78) = $UF_t3
! Overfrequency Protection 
$Out(79) = $OF_1
$Out(80) = $OF_2
$Out(81) = $OF_3
$Out(82) = $OF_t1
$Out(83) = $OF_t2
$Out(84) = $OF_t3

! GFL Current Injection
$Out(91) = 0
$Out(92) = 0
$Out(93) = 0
$Out(94) = 0
$Out(95) = 0
$Out(96) = 0
$Out(97) = 0
$Out(98) = 0
$Out(99) = 0
