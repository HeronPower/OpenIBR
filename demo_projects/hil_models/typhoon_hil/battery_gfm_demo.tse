    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        
        # Ratings
        
        F_nom = 60;
        VLL_nom = 480;
        S_nom = 1e6;
        
        
        # Dc math
        
        Vdc_nom = 1100;
        Zdc_pu = (Vdc_nom*Vdc_nom)/S_nom;
        
        R_dc = Zdc_pu * 0.01;
        C_dc = 1/Zdc_pu * 10;
        
        
        # Ac math
        
        Z_base = (VLL_nom*VLL_nom)/S_nom;
        L_pu = Z_base / (2*3.1415*F_nom);
        C_pu = 1/(Z_base * 2 * 3.1415 * F_nom);
        
        L_inv = L_pu * 0.02;
        C_x = C_pu * 0.04;
        rL_inv = Z_base * 0.02;
        
        L_gsu = L_pu * 0.15;
        r_gsu = Z_base * 0.02;
        
        # Model Stability Snubber
        R_snub = Z_base * 0.1;
        C_snub = C_pu * 0.01;
    ENDCODE
}
